[Unit]
Description=Cosmo listener - Hey Cosmo voice for the Muse gadget on Server 2
After=network.target

[Service]
ExecStart=/home/cosmo/cosmo-listener/listener.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/cosmo/cosmo-listener

[Install]
WantedBy=default.target
